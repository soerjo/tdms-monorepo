generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis()]
}

enum VehicleType {
  MOTORCYCLE
  VAN
  TRUCK_CDE
  TRUCK_CDD
}

enum TripStatus {
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DROPOFF
  RETURN_HUB
}

enum StopStatus {
  PENDING
  ARRIVED
  DELIVERED
  FAILED
  RTO
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalDirection {
  DEBIT
  CREDIT
}

model DeliveryTrip {
  id              String         @id @default(uuid()) @db.Uuid
  tripCode        String         @unique @map("trip_code") @db.VarChar(32)
  driverId        String         @map("driver_id") @db.Uuid
  vehicleType     VehicleType    @map("vehicle_type")
  status          TripStatus     @default(ASSIGNED)
  totalDistanceM  Int            @map("total_distance_m")
  totalDurationS  Int            @map("total_duration_s")
  routeGeometry   String?        @map("route_geometry") @db.Text
  idempotencyKey  String?        @unique @map("idempotency_key") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stops           DeliveryStop[]

  @@index([driverId, status], map: "idx_trips_driver_status")
  @@map("delivery_trips")
}

model DeliveryStop {
  id                  String       @id @default(uuid()) @db.Uuid
  tripId              String       @map("trip_id") @db.Uuid
  orderId             String       @map("order_id") @db.VarChar(64)
  sequenceOrder       Int          @map("sequence_order")
  stopType            StopType     @map("stop_type")
  latitude            Float        @map("latitude")
  longitude           Float        @map("longitude")
  addressMasked       String       @map("address_masked") @db.Text
  recipientName       String?      @map("recipient_name") @db.VarChar(100)
  timeWindowStart     DateTime?    @map("time_window_start") @db.Timestamptz(6)
  timeWindowEnd       DateTime?    @map("time_window_end") @db.Timestamptz(6)
  status              StopStatus   @default(PENDING)
  isCod               Boolean      @default(false) @map("is_cod")
  codAmount           Decimal      @default(0.00) @map("cod_amount") @db.Decimal(14, 2)
  geofenceVerified    Boolean      @default(false) @map("geofence_verified")
  podPhotoUrl         String?      @map("pod_photo_url") @db.Text
  podSignatureUrl     String?      @map("pod_signature_url") @db.Text
  failureReasonCode   String?      @map("failure_reason_code") @db.VarChar(32)
  actualArrivalAt     DateTime?    @map("actual_arrival_at") @db.Timestamptz(6)
  completedAt         DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  trip                DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sequenceOrder], map: "idx_stops_trip_seq")
  @@map("delivery_stops")
}

model LedgerAccount {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(32)
  name        String        @db.VarChar(100)
  type        AccountType
  balance     Decimal       @default(0.00) @db.Decimal(14, 2)
  currency    String        @default("IDR") @db.VarChar(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  lines       LedgerJournalLine[]

  @@map("ledger_accounts")
}

model LedgerJournalEntry {
  id                String       @id @default(uuid()) @db.Uuid
  transactionRefId  String       @map("transaction_ref_id") @db.VarChar(64)
  entryType         String       @map("entry_type") @db.VarChar(32)
  description       String?      @db.Text
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(64)
  postedAt          DateTime     @default(now()) @map("posted_at") @db.Timestamptz(6)

  lines             LedgerJournalLine[]

  @@index([transactionRefId], map: "idx_journal_ref")
  @@map("ledger_journal_entries")
}

model LedgerJournalLine {
  id              String             @id @default(uuid()) @db.Uuid
  journalEntryId  String             @map("journal_entry_id") @db.Uuid
  accountId       String             @map("account_id") @db.Uuid
  driverId        String?            @map("driver_id") @db.Uuid
  orderId         String?            @map("order_id") @db.VarChar(64)
  amount          Decimal            @db.Decimal(14, 2)
  direction       JournalDirection

  journalEntry    LedgerJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         LedgerAccount      @relation(fields: [accountId], references: [id])

  @@map("ledger_journal_lines")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(64)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(128)
  eventVersion  Int       @default(1) @map("event_version")
  topic         String    @db.VarChar(128)
  routingKey    String?   @map("routing_key") @db.VarChar(128)
  payload       Json
  headers       Json      @default("{}")
  status        String    @default("PENDING") @db.VarChar(16)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt], map: "idx_outbox_pending")
  @@map("outbox_events")
}
